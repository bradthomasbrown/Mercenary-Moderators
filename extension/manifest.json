{
  "manifest_version": 3,
  "name": "Mercenary Moderators",
  "version": "0.16.8",
  "description": "Tag 4chan posts, share tags on the market, and filter threads with your chosen tags.",
  "action": {
    "default_popup": "user-popup.html"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://mm.bradthomasbrown.com/*"
  ],
  "background": {
    "service_worker": "user-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.4chan.org/*/thread/*"
      ],
      "js": [
        "error-trace.js",
        "native-popup.js",
        "native-hiding.js",
        "market-component.js",
        "tagging-component.js",
        "packaged-rules.js",
        "persistent-rules.js"
      ],
      "css": [
        "adapter.css",
        "ios-buttons.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "options_page": "recovery.html",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "user@mm.bradthomasbrown.com"
    }
  }
}
